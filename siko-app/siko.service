[Unit]
Description=SIKO Eduventures Production Backend & Web App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/siko-app/backend
EnvironmentFile=/opt/siko-app/.env.production
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
