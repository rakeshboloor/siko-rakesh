# ==============================================================================
# SIKO EDUVENTURES — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
APP_ENV=production
API_PORT=8000
SECRET_KEY=siko-production-sec-key-replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Database Connection (Default SQLite; switch to PostgreSQL for high-scale clusters)
DATABASE_URL=sqlite:///./siko.db
# DATABASE_URL=postgresql://siko_admin:SecurePass123!@localhost:5432/siko_production

# Razorpay Route & Escrow Gateway Integration
# NOTE TO CTO: Insert live production keys here before opening public payment links
RAZORPAY_KEY_ID=PENDING_FROM_CTO
RAZORPAY_KEY_SECRET=PENDING_FROM_CTO
RAZORPAY_WEBHOOK_SECRET=PENDING_FROM_CTO
RAZORPAY_ACCOUNT_NUMBER=PENDING_FROM_CTO

# Automated Finance & Commission Rules (Immutable Financial Identities)
# 1-on-1 Mentorship Commission Rates
SIKO_COMMISSION_TIER_MASTER=18
SIKO_COMMISSION_TIER_EXPERT=22
SIKO_COMMISSION_TIER_SENIOR=25
SIKO_COMMISSION_TIER_PRO=28

# 1-to-Many Smart Batches (Max 30 Cohort) Commission Rate
SIKO_COMMISSION_BATCH_FIXED=50

# Milestone Escrow Release Percentages (Total = 100%)
ESCROW_M1_PCT=50
ESCROW_M2_PCT=25
ESCROW_M3_PCT=25

# Tax Compliance (Section 194J Professional Services)
TDS_194J_RATE=10

# SIKO Faculty Tier Hourly Rate Caps (Indian Market Norms)
# 1-on-1 Mentorship Hourly Caps
FACULTY_CAP_MASTER_1ON1=1200
FACULTY_CAP_EXPERT_1ON1=900
FACULTY_CAP_SENIOR_1ON1=700
FACULTY_CAP_PRO_1ON1=550

# Smart Circles (Batch Max 30) Per-Student Hourly Caps
FACULTY_CAP_MASTER_BATCH=260
FACULTY_CAP_EXPERT_BATCH=220
FACULTY_CAP_SENIOR_BATCH=180
FACULTY_CAP_PRO_BATCH=150

