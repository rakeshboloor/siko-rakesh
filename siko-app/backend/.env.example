# SIKO Production Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to source control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_BASE_URL=http://localhost:8000
API_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./siko.db
# For production: postgresql://user:password@host:5432/siko_db

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION
SESSION_SECRET=CHANGE-THIS-TOO
TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ── AI Provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=mock             # mock | gemini
AI_PROVIDER_KEY=             # Gemini API key (when AI_PROVIDER=gemini)

# ── Payment Provider ──────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock        # mock | razorpay

# ⚠️  RAZORPAY — ONLY PENDING EXTERNAL CONNECTION
# Leave empty until production credentials are ready.
# When ready: set PAYMENT_PROVIDER=razorpay and fill these:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Jitsi ─────────────────────────────────────────────────────────────────────
JITSI_SERVER=meet.jit.si
# JITSI_APP_ID=           # Optional: Jaas credentials for production
# JITSI_APP_SECRET=

# ── Communication Providers ───────────────────────────────────────────────────
EMAIL_PROVIDER=mock          # mock | sendgrid | ses
EMAIL_API_KEY=
EMAIL_FROM=noreply@siko.edu

SMS_PROVIDER=mock            # mock | twilio | msg91
SMS_API_KEY=

WHATSAPP_PROVIDER=mock       # mock | whatsapp_business
WHATSAPP_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local       # local | s3 | gcs
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
